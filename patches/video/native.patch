+  COMMAND git apply --check "${_deepgemm_fp16_patch}"
+  WORKING_DIRECTORY "${deepgemm_SOURCE_DIR}"
+  RESULT_VARIABLE _deepgemm_patch_check
+  OUTPUT_QUIET
+  ERROR_QUIET)
+if(_deepgemm_patch_check EQUAL 0)
