# Copy to .env and edit. Only WORKER is required.

# ssh destination of the second Spark (rank 1). Passwordless ssh, and its user
# can run docker. Its address on the direct cable makes the one-time copy of
# the ~207 GB of weights much faster.
WORKER=you@192.0.2.2

# Where the weights and the converted overlay live (~223 GB). The same absolute
# path is used on both Sparks. Default: $HOME/models/sparkglm
#MODEL_ROOT=/srv/models/sparkglm

# 4x512k (default): 4 requests x 512K context. 8x128k: 8 requests x 128K.
#PROFILE=4x512k

# Build the image from source instead of pulling ghcr.io/enntity/atlas-sparkglm.
#BUILD=1
# Parallel compile jobs for a source build; lower it if the build runs out of memory.
#ATLAS_BUILD_JOBS=4

# Only for private Hugging Face mirrors; the pinned checkpoints are public.
#HF_TOKEN=

# Detected from the RoCE device; set only if detection picks the wrong port.
#FABRIC_HCA=rocep1s0f0
#FABRIC_INTERFACE=enp1s0f0np0
#LEADER_ADDRESS=192.0.2.1
