    "layers": {
      "atlas_inf_main_base": "7ffd183f210708d5b1afba1e046049f14ad498c7",
      "shared_engine": {
        "branch": "upstream/atlas-shared-20261015-vision",
        "commit": "a94648109f3c9a9a739e6cdf3d9630acaf45bac8",
        "note": "The engine layer SparkGLM and SparkQwen share, on Atlas-Inf main 7ffd183f: the GLM-5.3-Flash series (port, RC4 commits, tool-call fixes, repeat notice; 236beb90), the Qwen3.8-Flash-Next series (gated by model type, off for GLM; 476e2208), the model-independent SparkQwen RC16 commits (speculation commits serial decode's tokens, one lowest-index greedy tie rule, shared-prefix admission, opt-in loop steering and prefill burst, step trace), the refusal-content fix, batched prefix-cache eviction, the shared vision fixes (every tower encodes per chunk into per-sequence state, vision layout errors fail only their request, MRoPE positions from the whole prompt, vision markup in message text encodes as text) and the vision prefix cache for every tower, and the shared-engine fixes: the w4a16_gemv_qg_batch4 lookup gated to qwen4_exp, sequence-parallel prefill kept with DFlash when its window fits rank 0's half, and ATLAS_MOE_INPLACE_TRANSPOSE (SparkGLM's profiles set 0, the consolidated transpose)."
      },
      "sparkglm_only": {
        "branch": "sparkglm/atlas-20261021-unified",
        "commit": "f4d95a100516338c938a4524e23a65a2c4c3206e",
        "base_commit": "b3b016ab7e91b73bea220b7280c9e9aa1a2cfb13",
        "note": "Accepted unified release on the published FP4-Local foundation. Model-independent candidates remain in this product layer until the next shared-engine refresh. SparkQwen and the shared branch are unchanged."
      }
    },
