@@ -0,0 +1,37 @@
+ARG BASE_IMAGE=sparkglm-vllm:fp16-cpasync-0c03250
+FROM ${BASE_IMAGE}
+
+ARG EXLLAMAV3_COMMIT=c5d9c657966ffeeaa9353f0cc899f18629da4a13
+
+COPY overlay/patch_exl3_ext_aarch64.py /opt/glm53/pair/patch_exl3_ext_aarch64.py
+COPY overlay/patch_exl3_fat_kernel.py /opt/glm53/pair/patch_exl3_fat_kernel.py
+COPY overlay/exl3_fat_gemm.cu /opt/glm53/pair/exl3_fat_gemm.cu
+COPY overlay/exl3_fat_gemm.cuh /opt/glm53/pair/exl3_fat_gemm.cuh
+
+ENV TORCH_CUDA_ARCH_LIST=12.1a
+ENV CUDA_HOME=/usr/local/cuda
+ENV MAX_JOBS=8
+ENV PATH=/usr/local/cuda/bin:${PATH}
+
+RUN set -eux; \
+    mkdir -p /tmp/exllamav3; \
+    curl -fsSL "https://github.com/turboderp-org/exllamav3/archive/${EXLLAMAV3_COMMIT}.tar.gz" \
+      | tar -xz -C /tmp/exllamav3 --strip-components=1; \
+    python3 /opt/glm53/pair/patch_exl3_ext_aarch64.py \
+      /tmp/exllamav3/exllamav3/exllamav3_ext; \
+    python3 /opt/glm53/pair/patch_exl3_fat_kernel.py \
+      /tmp/exllamav3/exllamav3/exllamav3_ext /opt/glm53/pair; \
+    export CPATH="/usr/local/lib/python3.12/dist-packages/nvidia/cu13/include${CPATH:+:$CPATH}"; \
+    export CPLUS_INCLUDE_PATH="/usr/local/lib/python3.12/dist-packages/nvidia/cu13/include${CPLUS_INCLUDE_PATH:+:$CPLUS_INCLUDE_PATH}"; \
+    export C_INCLUDE_PATH="/usr/local/lib/python3.12/dist-packages/nvidia/cu13/include${C_INCLUDE_PATH:+:$C_INCLUDE_PATH}"; \
+    cd /tmp/exllamav3; \
+    TORCH_CUDA_ARCH_LIST=12.1a MAX_JOBS=8 \
+      pip install --no-deps --no-build-isolation --no-cache-dir .; \
+    python3 -c "import exllamav3_ext; assert hasattr(exllamav3_ext, 'exl3_fat_gemm_pair'), dir(exllamav3_ext); assert hasattr(exllamav3_ext, 'exl3_fat_swiglu_had'), dir(exllamav3_ext); print(exllamav3_ext.__file__)"; \
+    rm -rf /tmp/exllamav3 /root/.cache/pip
+
+COPY overlay/exl3.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py
+COPY tests/test_exl3_overlay.py /opt/glm53/test_exl3_overlay.py
+
+LABEL ai.enntity.sparkglm.exl3-fat-pair="1"
+LABEL ai.enntity.sparkglm.exl3-fat-fused-act="1"
