+_cli_extra_args="${EXTRA_ARGS-}"
 _cli_ablit="${ABLIT-}"
 _cli_ablit_method="${ABLIT_METHOD-}"
 _cli_ablit_direction="${ABLIT_DIRECTION-}"
@@ -108,6 +111,8 @@ set +a
 [ -n "${_cli_util}" ] && GPU_MEM_UTIL="$_cli_util"
 [ -n "${_cli_lm}" ] && LANGUAGE_MODEL_ONLY="$_cli_lm"
 [ -n "${_cli_max_num_seqs}" ] && MAX_NUM_SEQS="$_cli_max_num_seqs"
+[ -n "${_cli_boot_long_c4}" ] && GLM53_BOOT_LONG_C4="$_cli_boot_long_c4"
+[ -n "${_cli_extra_args_set}" ] && EXTRA_ARGS="$_cli_extra_args"
 [ -n "${_cli_ablit}" ] && ABLIT="$_cli_ablit"
 [ -n "${_cli_ablit_method}" ] && ABLIT_METHOD="$_cli_ablit_method"
 [ -n "${_cli_ablit_direction}" ] && ABLIT_DIRECTION="$_cli_ablit_direction"
@@ -277,6 +282,8 @@ GLM53_SPINWAIT_MS="${GLM53_SPINWAIT_MS-16}"
 VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS="${VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS:-1800}"
 # 1 = after /health, burn DFlash2 BLOCK / sampler / kpool shapes. Nonfatal.
 GLM53_BOOT_SHAPE_WARMUP="${GLM53_BOOT_SHAPE_WARMUP:-1}"
+# 1 = additionally prove four resident staggered 16K requests. Fatal.
+GLM53_BOOT_LONG_C4="${GLM53_BOOT_LONG_C4:-1}"
 GLM53_WARMUP_REQ_TIMEOUT="${GLM53_WARMUP_REQ_TIMEOUT:-240}"
 
 # OpenAI-compatible API bearer token. Read the native VLLM_API_KEY env var
@@ -363,6 +370,28 @@ _glm53_validate_spinwait_ms() {
         GLM53_SPINWAIT_MS "$GLM53_SPINWAIT_MS" 1000
 }
 
+_glm53_validate_manual_kv_budget() {
+    # shellcheck disable=SC2206
+    local args=(${EXTRA_ARGS:-}) arg value="" index
+    for ((index = 0; index < ${#args[@]}; index++)); do
+        arg="${args[$index]}"
+        case "$arg" in
+            --kv-cache-memory-bytes=*) value="${arg#*=}" ;;
+            --kv-cache-memory-bytes)
+                index=$((index + 1))
+                value="${args[$index]-}"
+                ;;
+        esac
+    done
+    [ -z "$value" ] && return 0
+    _glm53_canonical_positive_int KV_CACHE_MEMORY_BYTES "$value" 1099511627776 \
+        || return
+    if [ "$MAX_NUM_SEQS" -ge 4 ] && [ "$value" -lt 19327352832 ]; then
+        echo "--kv-cache-memory-bytes=${value} cannot support the C4 appliance; use at least 19327352832 bytes or omit the override for GPU_MEM_UTIL=${GPU_MEM_UTIL}" >&2
+        return 2
+    fi
+}
+
 validate_numeric_config() {
     if ! [[ "$GPU_MEM_UTIL" =~ ^(0([.][0-9]+)?|[.][0-9]+|1([.]0+)?)$ ]] \
        || ! awk -v u="$GPU_MEM_UTIL" 'BEGIN { exit !(u > 0 && u <= 1) }'; then
@@ -375,6 +404,9 @@ validate_numeric_config() {
     _glm53_validate_enum GLM53_INDEXER_WORKSPACE "${GLM53_INDEXER_WORKSPACE-stock}" \
         stock rightsize || return
     _glm53_validate_spinwait_ms || return
+    _glm53_validate_manual_kv_budget || return
+    _glm53_validate_enum GLM53_BOOT_LONG_C4 "${GLM53_BOOT_LONG_C4-1}" 0 1 \
+        || return
 }
 # GLM53 numeric config guard (end)
 
@@ -1409,6 +1441,21 @@ post_ready_warmup() {
         || warn "boot shape warmup incomplete — uncovered shapes may JIT mid-serve on TP=2"
 }
 
+post_ready_c4_capacity_warmup() {
+    if [ "${GLM53_BOOT_LONG_C4:-1}" = "0" ] || [ "$MAX_NUM_SEQS" -lt 4 ]; then
+        log "long C4 capacity warmup skipped"
+        return 0
+    fi
+    [ -f "$SCRIPT_DIR/scripts/c4-capacity-warmup.sh" ] \
+        || die "scripts/c4-capacity-warmup.sh is missing"
+    log "long C4 capacity warmup (fatal; proves four resident 16K streams) ..."
+    GLM53_WARMUP_REQ_TIMEOUT="$GLM53_WARMUP_REQ_TIMEOUT" \
+    GLM53_WARMUP_BEARER="${VLLM_API_KEY:-}" \
+        bash "$SCRIPT_DIR/scripts/c4-capacity-warmup.sh" \
+            "http://127.0.0.1:${PORT}" "$SERVED_MODEL_NAME" \
+        || die "long C4 capacity warmup failed"
+}
+
 collect_failure_logs() {
     mkdir -p "$LOGDIR"
     docker logs "$CONTAINER_HEAD" >"$LOGDIR/head.log" 2>&1 || true
@@ -1472,6 +1519,7 @@ start() {
     launch_cluster
     if wait_for_health; then
         post_ready_warmup
+        post_ready_c4_capacity_warmup
         on_ready
         return
     fi
diff --git a/tests/test_image_recipe.py b/tests/test_image_recipe.py
index ba31143..38c26aa 100644
--- a/tests/test_image_recipe.py
+++ b/tests/test_image_recipe.py
@@ -12,6 +12,7 @@ ROOT = Path(__file__).resolve().parents[1]
 START = ROOT / "start.sh"
 DOCKERFILE = ROOT / "Dockerfile"
 ENV_EXAMPLE = ROOT / ".env.example"
+C4_CAPACITY_WARMUP = ROOT / "scripts" / "c4-capacity-warmup.sh"
 
 
 def test_documented_defaults() -> None:
@@ -50,8 +51,19 @@ def test_overlay_recipe_hash_runs() -> None:
     assert re.fullmatch(r"[0-9a-f]{64}", digest), digest
 
 
+def test_long_c4_capacity_warmup_is_fatal_and_checks_residency() -> None:
+    start = START.read_text()
+    warmup = C4_CAPACITY_WARMUP.read_text()
+    assert 'GLM53_BOOT_LONG_C4="${GLM53_BOOT_LONG_C4:-1}"' in start
+    assert "post_ready_c4_capacity_warmup" in start
+    assert '|| die "long C4 capacity warmup failed"' in start
+    assert 'if [ "$max_running" -lt 4 ]' in warmup
+    subprocess.run(["bash", "-n", C4_CAPACITY_WARMUP], check=True)
+
+
 if __name__ == "__main__":
     test_documented_defaults()
     test_recipe_stamp_wiring()
     test_overlay_recipe_hash_runs()
+    test_long_c4_capacity_warmup_is_fatal_and_checks_residency()
     print("image recipe tests: PASS")
diff --git a/tests/test_numeric_config.py b/tests/test_numeric_config.py
index 67179fb..fb5c926 100644
--- a/tests/test_numeric_config.py
+++ b/tests/test_numeric_config.py
@@ -129,6 +129,42 @@ def test_spinwait_numeric_contract() -> None:
         assert "GLM53_SPINWAIT_MS must" in result.stderr, bad
 
 
+def validate_manual_kv(extra_args: str) -> subprocess.CompletedProcess[str]:
+    script = (
+        guard_source()
+        + "\nGPU_MEM_UTIL=0.87; MAX_MODEL_LEN=1000000; MAX_NUM_SEQS=4; "
+        + "MAX_NUM_BATCHED_TOKENS=7168; GLM53_INDEXER_WORKSPACE=rightsize; "
+        + 'GLM53_SPINWAIT_MS=16; EXTRA_ARGS="$1"\n'
+        + "validate_numeric_config\n"
+    )
+    return subprocess.run(
+        ["bash", "-c", script, "test", extra_args],
+        text=True,
+        capture_output=True,
+        check=False,
+        env={**os.environ, "LC_ALL": "C"},
+    )
+
+
+def test_manual_kv_budget_cannot_silently_reduce_c4_to_c2() -> None:
+    for good in (
+        "",
+        "--cudagraph-capture-sizes 1 2 4 8 16 24 32",
+        "--kv-cache-memory-bytes 19327352832",
+        "--kv-cache-memory-bytes=20000000000",
+    ):
+        result = validate_manual_kv(good)
+        assert result.returncode == 0, (good, result.stderr)
+
+    for bad in (
+        "--kv-cache-memory-bytes 10737418240",
+        "--kv-cache-memory-bytes=10200547328",
+        "--kv-cache-memory-bytes nope",
+    ):
+        result = validate_manual_kv(bad)
+        assert result.returncode == 2, (bad, result.stderr)
+
+
 def test_restart_validates_before_stop() -> None:
     source = START.read_text()
     main = source.index("main() {")
@@ -142,5 +178,6 @@ if __name__ == "__main__":
     test_decimal_normalization()
     test_indexer_workspace_enum()
     test_spinwait_numeric_contract()
+    test_manual_kv_budget_cannot_silently_reduce_c4_to_c2()
     test_restart_validates_before_stop()
     print("numeric config tests: PASS")
