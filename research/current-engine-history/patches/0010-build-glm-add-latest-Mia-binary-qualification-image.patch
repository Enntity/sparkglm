From f9553ea405a7bd9e453f162ba369808a5c3c259e Mon Sep 17 00:00:00 2001
From: Jason McCartney <jmacAJ@users.noreply.github.com>
Date: Thu, 3 Sep 2026 11:49:51 -0700
Subject: [PATCH 10/21] build(glm): add latest-Mia binary qualification image

Derive from the untouched eb0469f control and copy only the previously qualified native artifacts, then apply the accepted runtime Python deltas.

Co-authored-by: OpenAI Codex <codex@openai.com>
---
 Dockerfile.sparkglm-binary                    |  53 +++
 SPARKGLM.md                                   |   8 +
 .../runtime/native-fp16-sparse-selector.patch | 331 ++++++++++++++++++
 patches/runtime/packed-rmsnorm.patch          |  18 +
 4 files changed, 410 insertions(+)
 create mode 100644 Dockerfile.sparkglm-binary
 create mode 100644 patches/runtime/native-fp16-sparse-selector.patch
 create mode 100644 patches/runtime/packed-rmsnorm.patch

diff --git a/Dockerfile.sparkglm-binary b/Dockerfile.sparkglm-binary
new file mode 100644
index 0000000..ef17517
--- /dev/null
+++ b/Dockerfile.sparkglm-binary
@@ -0,0 +1,53 @@
+# Fast qualification image: combine the untouched latest-Mia control with the
+# already qualified native artifacts, then apply only the accepted Python
+# deltas. The canonical source patches live under patches/vllm/.
+ARG CONTROL_IMAGE=lloom-glm53-mia-eb0469:exl3
+ARG ACCEPTED_IMAGE=sparkglm-vllm:exl3-m64-candidate-20260903a
+
+FROM ${ACCEPTED_IMAGE} AS accepted
+FROM ${CONTROL_IMAGE}
+
+COPY --from=accepted \
+  /usr/local/lib/python3.12/dist-packages/vllm/_C_stable_libtorch.abi3.so \
+  /usr/local/lib/python3.12/dist-packages/vllm/_C_stable_libtorch.abi3.so
+COPY --from=accepted \
+  /usr/local/lib/python3.12/dist-packages/vllm/third_party/deep_gemm/ \
+  /usr/local/lib/python3.12/dist-packages/vllm/third_party/deep_gemm/
+COPY --from=accepted \
+  /usr/local/lib/python3.12/dist-packages/exllamav3_ext.cpython-312-aarch64-linux-gnu.so \
+  /usr/local/lib/python3.12/dist-packages/exllamav3_ext.cpython-312-aarch64-linux-gnu.so
+
+COPY patches/runtime/ /opt/sparkglm/runtime-patches/
+RUN set -eux; \
+    cd /usr/local/lib/python3.12/dist-packages; \
+    patch -p1 < /opt/sparkglm/runtime-patches/packed-rmsnorm.patch; \
+    patch -p1 < /opt/sparkglm/runtime-patches/native-fp16-sparse-selector.patch
+
+COPY overlay/exl3.py \
+  /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py
+COPY tests/test_exl3_overlay.py /opt/glm53/test_exl3_overlay.py
+
+RUN python3 - <<'PY'
+import torch
+import exllamav3_ext as ext
+
+required = (
+    "exl3_fat_gemm_pair",
+    "exl3_fat_swiglu_had",
+    "exl3_fat_gemm_m64",
+    "exl3_fat_gemm_pair_m64",
+    "exl3_fat_gemm_scatter_m64",
+)
+missing = [name for name in required if not hasattr(ext, name)]
+assert not missing, missing
+print("SparkGLM accepted native artifacts present")
+PY
+
+ARG SPARKGLM_RECIPE_REVISION=unknown
+LABEL ai.enntity.sparkglm.mia-base="eb0469fbb2b49fd7c025f594a3339a121e58f7a9" \
+      ai.enntity.sparkglm.recipe-revision="${SPARKGLM_RECIPE_REVISION}" \
+      ai.enntity.sparkglm.artifact-source="accepted-source-build" \
+      ai.enntity.sparkglm.fp16-selector="1" \
+      ai.enntity.sparkglm.exl3-fat-pair="1" \
+      ai.enntity.sparkglm.exl3-fat-fused-act="1" \
+      ai.enntity.sparkglm.exl3-fat-tile-m="64"
diff --git a/SPARKGLM.md b/SPARKGLM.md
index c48979e..d095b7c 100644
--- a/SPARKGLM.md
+++ b/SPARKGLM.md
@@ -24,3 +24,11 @@ For a fair endpoint comparison, the untouched and optimized images must use
 the same model revision, DFlash revision and topology, KV/cache budget,
 scheduler settings, warmup workload, prompts, arrival offsets, output length,
 and alternating run order. A ready banner alone is not equivalent warm state.
+
+For fast qualification on the existing Sparks,
+`Dockerfile.sparkglm-binary` derives directly from the untouched Mia control
+image and copies native artifacts from the previously qualified source build.
+It then applies only the two runtime Python patches above. This avoids a second
+full vLLM compile while ensuring the final filesystem starts from latest Mia,
+not from the historical source-integrated image. It is a qualification path;
+the patch-based source build remains the canonical reproducible path.
