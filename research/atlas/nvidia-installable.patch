+    fn try_glm_sparse_tc_decode_heads(
+        &self,
+        ctx: &ForwardContext,
+        query: DevicePtr,
+        kv_cache: &PagedKvCache,
+        indices: DevicePtr,
+        index_width: u32,
+        output: DevicePtr,
+        block_table: DevicePtr,
+        heads: u32,
+        head_dim: u32,
+        scale: f32,
+        stream: u64,
+    ) -> Result<bool> {
+        const GROUP: u32 = 32;
+        // ops::glm_sparse_decode_split's partial O + LSE + merge scratch.
+        const SPLIT_SCRATCH_BYTES: usize = 8 * 32 * 512 * 4 + 8 * 32 * 4 + 32 * 4;
