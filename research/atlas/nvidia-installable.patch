+    let patch_volume = vcfg.temporal_patch_size.max(1).saturating_mul(
+        vcfg.patch_size
+            .max(1)
+            .saturating_mul(vcfg.patch_size.max(1)),
+    );
+    let merge_factor = if video {
+        vcfg.spatial_merge_size
+            .max(1)
+            .saturating_mul(vcfg.spatial_merge_size.max(1))
