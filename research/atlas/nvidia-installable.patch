+                ss[j] += nv[j].x * nv[j].x + nv[j].y * nv[j].y;
+            }
+            #pragma unroll
+            for (unsigned int m = 0; m < M; ++m) {
+                const float2 f = s_fn[(m * 4 + st) * (GLM_HC_PM_DC / 2) + lane];
+                #pragma unroll
+                for (unsigned int j = 0; j < GLM_HC_MIX_TPW; ++j)
