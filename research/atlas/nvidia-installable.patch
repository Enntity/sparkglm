+        }
+    }
+    #pragma unroll
+    for (unsigned int j = 0; j < GLM_HC_MIX_TPW; ++j) {
+        #pragma unroll
+        for (unsigned int o = 16; o > 0; o >>= 1) {
+            ss[j] += __shfl_xor_sync(0xffffffffu, ss[j], o);
+            #pragma unroll
+            for (unsigned int m = 0; m < M; ++m)
