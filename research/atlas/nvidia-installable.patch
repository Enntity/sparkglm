+pub fn tc_rows(kernel: KernelHandle) -> Option<u32> {
+    let handles = TC.get()?;
+    (kernel.0 != 0)
+        .then(|| handles.iter().position(|h| h.0 == kernel.0))
+        .flatten()
+        .map(|i| TC_ROWS[i])
+}
