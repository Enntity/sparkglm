+// TORCH_CHECK_DIM(x, D):                       assert x has D dimensions
+// TORCH_CHECK_DIM_OPT(x, D):                   assert x has D dimensions, unless x is None
+// TORCH_CHECK_SIZE(x, i, s):                   assert x.size(i) == s
