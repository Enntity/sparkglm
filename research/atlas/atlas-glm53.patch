+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SOURCE: &str =
+        include_str!("../../../../../kernels/gb10/glm-5.3-flash/exl3/glm53_dsa_prefill.cu");
+    const REGISTRY: &str =
+        include_str!("../../../../../kernels/gb10/glm-5.3-flash/exl3/KERNEL.toml");
