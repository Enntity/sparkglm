+    auto state=values<float>(hsize,43+mode,mode==2?4.f:.5f);initial.upload(state);old_h.upload(state);new_h.upload(state);
+    cudaStream_t stream;CHECK(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking));
