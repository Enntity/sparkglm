+            for (unsigned j = 0; j < 4; ++j) {
+                float v = post[lr][j] * x;
+                #pragma unroll
+                for (unsigned i = 0; i < 4; ++i) v += comb[lr][i * 4 + j] * rv[i];
+                if (valid) highway_out[size_t(row) * D + j * H + db + d] = v;
+                sumsq += v * v;
+                a[lr][j * 32 + d] = __float_to_tf32(v);
+            }
+        }
