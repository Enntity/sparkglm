+            for pos in positions {
+                expected.extend([801, 802]);
+                if pos + 1 > 2048 {
+                    expected.extend([803, sparse_kernel]);
+                }
+            }
+            assert_eq!(
+                index, expected,
+                "causal rows must maintain index before selecting sparse attention"
+            );
+        }
+    });
+}
