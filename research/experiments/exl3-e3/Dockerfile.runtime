# SPDX-License-Identifier: Apache-2.0
ARG BASE_IMAGE=sparkglm-candidate:e3-20260907
FROM ${BASE_IMAGE}
COPY research/experiments/exl3-e3/runtime.py /usr/local/lib/python3.12/dist-packages/sparkglm_e3.py
COPY research/experiments/exl3-e3/tables.py /usr/local/lib/python3.12/dist-packages/sparkglm_e3_tables.py
COPY research/experiments/exl3-e3/install.py /opt/glm53/e3/install.py
RUN python3 -S /opt/glm53/e3/install.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py
# Candidate is opt-in through the managed runtime profile, not enabled here.
ARG SPARKGLM_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.revision=${SPARKGLM_SOURCE_REVISION}
