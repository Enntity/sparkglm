+# SPDX-License-Identifier: Apache-2.0
+"""Compare host-dispatched E2 fat experts with persistent GPU fat tiles.
+
+This measures the complete routed-expert apply boundary: mapping, sorting,
+count construction, thin experts, oversized experts, activation, weighted
+scatter, and every host synchronization/launch gap.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import time
+import types
+
+import torch
+
+from vllm.model_executor.layers.quantization.exl3 import (
+    MCG_MARKER_SIGNED_INT32,
+    Exl3Config,
+    Exl3MoEMethod,
+    apply_exl3_experts,
+)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tokens", nargs="+", type=int, default=(512, 2048, 7168))
+    parser.add_argument("--experts", type=int, default=288)
+    parser.add_argument("--topk", type=int, default=8)
+    parser.add_argument("--hidden", type=int, default=4096)
+    parser.add_argument("--intermediate", type=int, default=1024)
+    parser.add_argument("--warmup", type=int, default=2)
+    parser.add_argument("--iterations", type=int, default=5)
+    parser.add_argument("--seed", type=int, default=53)
+    parser.add_argument("--zipf", type=float, default=1.0)
+    return parser.parse_args()
+
+
+def make_layer(args: argparse.Namespace, device: torch.device) -> torch.nn.Module:
+    moe = types.SimpleNamespace(swiglu_limit=10.0)
+    method = Exl3MoEMethod(moe, Exl3Config())
+    layer = torch.nn.Module()
+    method.create_weights(
+        layer,
+        num_experts=args.experts,
+        hidden_size=args.hidden,
+        intermediate_size_per_partition=args.intermediate,
+        params_dtype=torch.float16,
+    )
+    generator = torch.Generator(device="cpu")
+    generator.manual_seed(args.seed)
+    with torch.no_grad():
+        layer.w13_trellis.random_(-30000, 30000, generator=generator)
+        layer.w2_trellis.random_(-30000, 30000, generator=generator)
+        layer.w13_suh.normal_(generator=generator)
+        layer.w13_svh.normal_(generator=generator)
+        layer.w2_suh.normal_(generator=generator)
+        layer.w2_svh.normal_(generator=generator)
+        # The appliance checkpoint shares gate/up input SUH, which is required
+        # by the accepted paired E2 path.
+        layer.w13_suh[:, 1].copy_(layer.w13_suh[:, 0])
+        layer.w13_mcg.fill_(MCG_MARKER_SIGNED_INT32)
+        layer.w2_mcg.fill_(MCG_MARKER_SIGNED_INT32)
+    layer = layer.to(device)
+    method.process_weights_after_loading(layer)
+    return layer
+
+
+def make_routes(
+    args: argparse.Namespace, tokens: int, device: torch.device
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    generator = torch.Generator(device="cpu")
+    generator.manual_seed(args.seed + tokens)
+    rank = torch.arange(1, args.experts + 1, dtype=torch.float64)
+    probs = rank.pow(-args.zipf)
+    probs /= probs.sum()
+    ids = torch.multinomial(
+        probs.expand(tokens, -1),
+        args.topk,
+        replacement=False,
+        generator=generator,
+    )
+    logits = torch.randn(tokens, args.topk, generator=generator)
+    weights = logits.softmax(-1).half()
+    x = torch.randn(tokens, args.hidden, dtype=torch.float16, generator=generator)
+    counts = torch.bincount(ids.reshape(-1), minlength=args.experts)
+    return x.to(device), ids.to(device), weights.to(device), counts
+
+
+def run_mode(
+    layer: torch.nn.Module,
+    x: torch.Tensor,
+    ids: torch.Tensor,
+    weights: torch.Tensor,
+    enabled: bool,
+    warmup: int,
+    iterations: int,
+) -> tuple[torch.Tensor, float]:
+    os.environ["EXL3_FAT_DEVICE_TILES"] = "1" if enabled else "0"
+    os.environ["EXL3_MOE_ROW_TILE"] = "0"
+    os.environ["EXL3_FAT_KERNEL"] = "1"
+    os.environ["EXL3_FAT_PAIR"] = "1"
+    os.environ["EXL3_FAT_FUSED_ACT"] = "1"
+    os.environ["EXL3_FAT_EXPERT_LOG"] = "0"
+    for _ in range(warmup):
+        output = apply_exl3_experts(x, ids, weights, layer, fused=True)
+    torch.cuda.synchronize()
+    started = time.perf_counter()
+    for _ in range(iterations):
+        output = apply_exl3_experts(x, ids, weights, layer, fused=True)
+    torch.cuda.synchronize()
+    elapsed_ms = 1000.0 * (time.perf_counter() - started) / iterations
+    return output, elapsed_ms
+
+
+def main() -> None:
+    args = parse_args()
+    if not torch.cuda.is_available():
+        raise RuntimeError("CUDA is required")
+    import exllamav3_ext
+
+    assert exllamav3_ext.exl3_moe_fat_tiles_version() == 1
+    device = torch.device("cuda:0")
+    torch.manual_seed(args.seed)
+    layer = make_layer(args, device)
+    cap = int(layer._exl3_fused_temps[0].shape[1])
+    for tokens in args.tokens:
+        x, ids, weights, counts = make_routes(args, tokens, device)
+        accepted, accepted_ms = run_mode(
+            layer, x, ids, weights, False, args.warmup, args.iterations
+        )
+        candidate, candidate_ms = run_mode(
+            layer, x, ids, weights, True, args.warmup, args.iterations
+        )
+        diff = (candidate.float() - accepted.float()).abs()
+        reference = accepted.float().abs()
+        result = {
+            "tokens": tokens,
+            "experts": args.experts,
+            "topk": args.topk,
+            "cap": cap,
+            "fat_experts": int((counts > cap).sum()),
+            "max_expert_rows": int(counts.max()),
+            "accepted_ms": accepted_ms,
+            "device_tiles_ms": candidate_ms,
+            "speedup": accepted_ms / candidate_ms,
+            "max_abs": float(diff.max()),
+            "mean_abs": float(diff.mean()),
+            "relative_max": float(diff.max() / reference.max().clamp_min(1e-6)),
+            "finite": bool(torch.isfinite(candidate).all()),
+        }
+        print(json.dumps(result, sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
+    main()
