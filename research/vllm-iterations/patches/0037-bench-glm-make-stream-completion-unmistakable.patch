From 772c605675d4ec9cea9faafc76b7f9678954697b Mon Sep 17 00:00:00 2001
From: Jason McCartney <jmacAJ@users.noreply.github.com>
Date: Thu, 3 Sep 2026 10:38:01 -0700
Subject: [PATCH 37/37] bench(glm): make stream completion unmistakable

Latch completed panes into a high-contrast green state with a brief flash, bold border, full-width header, and persistent DONE label.

Co-authored-by: OpenAI Codex <codex@openai.com>
---
 benchmarks/sparkglm/four_stream_video.py | 71 +++++++++++++++++++++---
 1 file changed, 64 insertions(+), 7 deletions(-)

diff --git a/benchmarks/sparkglm/four_stream_video.py b/benchmarks/sparkglm/four_stream_video.py
index 5c1ed5ee08..8c7a43dbb1 100644
--- a/benchmarks/sparkglm/four_stream_video.py
+++ b/benchmarks/sparkglm/four_stream_video.py
@@ -283,6 +283,17 @@ def _wrapped_lines(text: str, width: int) -> list[str]:
     return lines
 
 
+def _mix_color(start: str, end: str, amount: float) -> str:
+    """Blend two RGB hex colors for a brief completion flash."""
+    amount = min(max(amount, 0.0), 1.0)
+    start_rgb = tuple(int(start[index : index + 2], 16) for index in (1, 3, 5))
+    end_rgb = tuple(int(end[index : index + 2], 16) for index in (1, 3, 5))
+    mixed = tuple(
+        round(left + (right - left) * amount) for left, right in zip(start_rgb, end_rgb)
+    )
+    return "#" + "".join(f"{channel:02x}" for channel in mixed)
+
+
 def render(args: argparse.Namespace) -> None:
     from PIL import Image, ImageDraw
 
