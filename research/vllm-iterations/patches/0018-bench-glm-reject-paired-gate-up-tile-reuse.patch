+| 145 | 0.1153 | 0.1780 | +54.4% |
+| 192 | 0.1197 | 0.1838 | +53.5% |
+| 255 | 0.1658 | 0.1910 | +15.2% |
+| 257 | 0.1735 | 0.2000 | +15.3% |
+| 320 | 0.1867 | 0.2226 | +19.2% |
+| 383 | 0.1940 | 0.2249 | +15.9% |
+| 385 | 0.2390 | 0.2730 | +14.2% |
+| 512 | 0.2882 | 0.3162 | +9.7% |
+| 640 | 0.3540 | 0.3478 | -1.7% |
