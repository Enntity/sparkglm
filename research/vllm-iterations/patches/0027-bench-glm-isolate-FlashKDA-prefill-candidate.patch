@@ -0,0 +1,221 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Compare GLM-5.3's Triton chunk KDA with FlashKDA on SM121.
+
+Run in a CUDA vLLM image that contains ``vllm._flashkda_C``. The benchmark
+uses the exact TP-local GLM-5.3 dimensions and bounded-gate arithmetic but does
+not load model weights.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import statistics
+from collections.abc import Callable
+
+import torch
+
+from vllm.third_party.flash_linear_attention.ops.kda import (
+    chunk_kda_with_fused_gate,
+)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tokens", nargs="+", type=int, default=(2048, 7168))
+    parser.add_argument("--sequences", type=int, default=2)
+    parser.add_argument("--heads", type=int, default=32)
+    parser.add_argument("--head-dim", type=int, default=128)
+    parser.add_argument("--lower-bound", type=float, default=-5.0)
+    parser.add_argument("--warmup", type=int, default=3)
+    parser.add_argument("--iterations", type=int, default=10)
+    parser.add_argument("--repeats", type=int, default=5)
+    parser.add_argument("--seed", type=int, default=11)
+    return parser.parse_args()
+
+
+def timed_ms(
+    operation: Callable[[], None],
+    warmup: int,
+    iterations: int,
+) -> float:
+    for _ in range(warmup):
+        operation()
+    torch.cuda.synchronize()
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(iterations):
+        operation()
+    end.record()
+    end.synchronize()
+    return start.elapsed_time(end) / iterations
+
+
+def relative_rmse(reference: torch.Tensor, candidate: torch.Tensor) -> float:
+    difference = reference.float() - candidate.float()
+    rmse_difference = difference.square().mean().sqrt()
+    rmse_reference = reference.float().square().mean().sqrt()
+    return float(rmse_difference / (rmse_reference + 1e-8))
+
+
+@torch.inference_mode()
+def benchmark(args: argparse.Namespace, tokens: int) -> dict:
+    import vllm._flashkda_C  # noqa: F401
+
+    if tokens % args.sequences:
+        raise ValueError("tokens must divide evenly across sequences")
+
+    torch.manual_seed(args.seed)
+    device = torch.device("cuda:0")
+    shape = (1, tokens, args.heads, args.head_dim)
+    q, k, v, raw_g = [
+        torch.randn(shape, dtype=torch.bfloat16, device=device) for _ in range(4)
+    ]
+    beta_raw = torch.randn(
+        1, tokens, args.heads, dtype=torch.bfloat16, device=device
+    )
+    beta = beta_raw.float().sigmoid()
+    a_log = torch.randn(args.heads, dtype=torch.float32, device=device) * 0.5
+    dt_bias = (
+        torch.randn(
+            args.heads, args.head_dim, dtype=torch.float32, device=device
+        )
+        * 0.1
+    )
+    initial_state = torch.randn(
+        args.sequences,
+        args.heads,
+        args.head_dim,
+        args.head_dim,
+        dtype=torch.float32,
+        device=device,
+    )
+    step = tokens // args.sequences
+    cu_seqlens = torch.arange(
+        0,
+        tokens + 1,
+        step,
+        dtype=torch.int32,
+        device=device,
+    )
+
+    flash_out = torch.empty_like(v)
+    flash_state = torch.empty_like(initial_state)
+    workspace_size = torch.ops._flashkda_C.get_workspace_size(
+        tokens, args.heads, args.sequences
+    )
+    workspace = torch.empty(workspace_size, dtype=torch.uint8, device=device)
+
+    def run_triton() -> tuple[torch.Tensor, torch.Tensor]:
+        return chunk_kda_with_fused_gate(
+            q=q,
+            k=k,
+            v=v,
+            raw_g=raw_g,
+            beta=beta,
+            A_log=a_log,
+            g_bias=dt_bias,
+            initial_state=initial_state,
+            output_final_state=True,
+            use_qk_l2norm_in_kernel=True,
+            cu_seqlens=cu_seqlens,
+            safe_gate=True,
+            lower_bound=args.lower_bound,
+        )
+
+    def run_flash() -> tuple[torch.Tensor, torch.Tensor]:
+        torch.ops._flashkda_C.fwd(
+            q,
+            k,
+            v,
+            raw_g,
+            beta_raw,
+            args.head_dim**-0.5,
+            flash_out,
+            workspace,
+            a_log,
+            dt_bias,
+            args.lower_bound,
+            initial_state,
+            flash_state,
+            cu_seqlens,
+        )
+        return flash_out, flash_state
+
+    triton_out, triton_state = run_triton()
+    candidate_out, candidate_state = run_flash()
+    torch.cuda.synchronize()
+    output_delta = (triton_out.float() - candidate_out.float()).abs()
+    state_delta = (triton_state.float() - candidate_state.float()).abs()
+    transposed_state = candidate_state.transpose(-1, -2)
+    transposed_state_delta = (
+        triton_state.float() - transposed_state.float()
+    ).abs()
+
+    timings: dict[str, list[float]] = {"triton": [], "flashkda": []}
+    operations = {"triton": run_triton, "flashkda": run_flash}
+    for repeat in range(args.repeats):
+        order = tuple(operations) if repeat % 2 == 0 else tuple(reversed(operations))
+        for name in order:
+            timings[name].append(
+                timed_ms(operations[name], args.warmup, args.iterations)
+            )
+
+    triton_ms = statistics.median(timings["triton"])
+    flash_ms = statistics.median(timings["flashkda"])
+    return {
+        "tokens": tokens,
+        "sequences": args.sequences,
+        "heads": args.heads,
+        "head_dim": args.head_dim,
+        "lower_bound": args.lower_bound,
+        "workspace_mib": workspace_size / 1024**2,
+        "triton_ms": triton_ms,
+        "flashkda_ms": flash_ms,
+        "speedup": triton_ms / flash_ms,
+        "output_max_abs": float(output_delta.max()),
+        "output_mean_abs": float(output_delta.mean()),
+        "output_relative_rmse": relative_rmse(triton_out, candidate_out),
+        "state_max_abs": float(state_delta.max()),
+        "state_mean_abs": float(state_delta.mean()),
+        "state_relative_rmse": relative_rmse(triton_state, candidate_state),
+        "triton_state_rms": float(triton_state.float().square().mean().sqrt()),
+        "flashkda_state_rms": float(
+            candidate_state.float().square().mean().sqrt()
+        ),
+        "transposed_state_max_abs": float(transposed_state_delta.max()),
+        "transposed_state_mean_abs": float(transposed_state_delta.mean()),
+        "transposed_state_relative_rmse": relative_rmse(
+            triton_state, transposed_state
+        ),
+        "output_close_1e_2": bool(
+            torch.allclose(triton_out, candidate_out, atol=0.01, rtol=0.01)
+        ),
+        "state_close_1e_2": bool(
+            torch.allclose(triton_state, candidate_state, atol=0.01, rtol=0.01)
+        ),
+        "transposed_state_close_1e_2": bool(
+            torch.allclose(
+                triton_state,
+                transposed_state,
+                atol=0.01,
+                rtol=0.01,
+            )
+        ),
+        "triton_samples_ms": timings["triton"],
+        "flashkda_samples_ms": timings["flashkda"],
+    }
+
+
+def main() -> None:
+    args = parse_args()
+    if torch.cuda.get_device_capability() != (12, 1):
+        raise RuntimeError("this appliance benchmark requires SM121")
+    for tokens in args.tokens:
+        print(json.dumps(benchmark(args, tokens), sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
+    main()
