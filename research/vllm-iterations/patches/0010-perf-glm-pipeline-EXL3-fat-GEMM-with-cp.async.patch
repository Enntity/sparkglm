+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Benchmark the SM121 EXL3 fat-expert GEMM without loading model weights.
+
+Run this script inside a SparkGLM image so ``exllamav3_ext`` resolves to that
+image's compiled extension. The defaults cover the three GLM-5.3 Flash expert
+matrix K dimensions at the 3,584-row reference prefill shape.
+"""
+
+import argparse
+import json
+
+import exllamav3_ext
+import torch
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--rows", type=int, default=3584)
+    parser.add_argument("--k", nargs="+", type=int, default=(2048, 4096, 8192))
+    parser.add_argument("--n", type=int, default=2048)
+    parser.add_argument("--warmup", type=int, default=20)
+    parser.add_argument("--iterations", type=int, default=100)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument(
+        "--epilogue",
+        choices=("direct", "scatter"),
+        default="direct",
+    )
+    return parser.parse_args()
+
+
+def benchmark(args: argparse.Namespace, size_k: int) -> dict[str, float | int | str]:
+    torch.manual_seed(args.seed)
+    device = torch.device("cuda:0")
+    activations = torch.randn(
+        args.rows,
+        size_k,
+        dtype=torch.float16,
+        device=device,
+    )
+    packed = torch.randint(
+        -32768,
+        32767,
+        (size_k // 16, args.n // 16, 64),
+        dtype=torch.int16,
+        device=device,
+    )
+    svh = torch.ones(args.n, dtype=torch.float16, device=device)
+    output = torch.empty(
+        args.rows,
+        args.n,
+        dtype=torch.float32,
+        device=device,
+    )
+    token_idx = torch.arange(args.rows, dtype=torch.int64, device=device)
+    route_weight = torch.ones(args.rows, dtype=torch.float16, device=device)
+
+    if args.epilogue == "direct":
+
+        def launch() -> None:
+            exllamav3_ext.exl3_fat_gemm(
+                activations,
+                packed,
+                output,
+                svh,
+                4,
+                True,
+                False,
+            )
+
+    else:
+
+        def launch() -> None:
+            output.zero_()
+            exllamav3_ext.exl3_fat_gemm_scatter(
+                activations,
+                packed,
+                output,
+                svh,
+                token_idx,
+                route_weight,
+                4,
+                True,
+                False,
+            )
+
+    for _ in range(args.warmup):
+        launch()
+    torch.cuda.synchronize()
+
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(args.iterations):
+        launch()
+    end.record()
+    end.synchronize()
+
+    mean_ms = start.elapsed_time(end) / args.iterations
+    equivalent_tflops = (
+        2 * args.rows * size_k * args.n / (mean_ms / 1000) / 1e12
+    )
+    return {
+        "epilogue": args.epilogue,
+        "rows": args.rows,
+        "k": size_k,
+        "n": args.n,
+        "mean_ms": mean_ms,
+        "equivalent_tflops": equivalent_tflops,
+    }
+
+
+def main() -> None:
+    args = parse_args()
+    for size_k in args.k:
+        print(json.dumps(benchmark(args, size_k), sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
