@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Compare 128-row and 64-row SM121 EXL3 fat-expert pipelines.
+
+Run inside a SparkGLM image containing the additive ``*_m64`` symbols. The
+timed region covers paired gate/up, fused SwiGLU/Hadamard, and down/scatter.
+"""
+
+import argparse
+import json
+import statistics
+
+import exllamav3_ext
+import torch
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--rows",
+        nargs="+",
+        type=int,
+        default=(129, 145, 192, 255, 257, 320, 383, 385, 512, 640, 768, 1024),
+    )
+    parser.add_argument("--hidden", type=int, default=4096)
+    parser.add_argument("--intermediate", type=int, default=1024)
+    parser.add_argument("--warmup", type=int, default=20)
+    parser.add_argument("--iterations", type=int, default=100)
+    parser.add_argument("--repeats", type=int, default=5)
+    parser.add_argument("--seed", type=int, default=0)
+    return parser.parse_args()
+
+
+def benchmark(
+    args: argparse.Namespace, rows: int
+) -> dict[str, float | int | list[float]]:
+    torch.manual_seed(args.seed)
+    device = torch.device("cuda:0")
+    hidden = args.hidden
+    intermediate = args.intermediate
+    xh = torch.randn(rows, hidden, dtype=torch.float16, device=device)
+    gu_shape = (hidden // 16, intermediate // 16, 64)
+    down_shape = (intermediate // 16, hidden // 16, 64)
+    gate = torch.randint(-32768, 32767, gu_shape, dtype=torch.int16, device=device)
+    up = torch.randint(-32768, 32767, gu_shape, dtype=torch.int16, device=device)
+    down = torch.randint(-32768, 32767, down_shape, dtype=torch.int16, device=device)
+    gate_svh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    up_svh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    down_suh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    down_svh = torch.randn(hidden, dtype=torch.float16, device=device)
+    token_idx = torch.arange(rows, dtype=torch.int64, device=device)
+    route_weight = torch.rand(rows, dtype=torch.float16, device=device)
+
+    gate_up_128 = torch.empty(
+        rows, 2 * intermediate, dtype=torch.float32, device=device
+    )
+    gate_up_64 = torch.empty_like(gate_up_128)
+    h2_128 = torch.empty(rows, intermediate, dtype=torch.float16, device=device)
+    h2_64 = torch.empty_like(h2_128)
+    out_128 = torch.zeros(rows, hidden, dtype=torch.float32, device=device)
+    out_64 = torch.zeros_like(out_128)
+
+    def launch_128() -> None:
+        exllamav3_ext.exl3_fat_gemm_pair(
+            xh, gate, up, gate_up_128, gate_svh, up_svh, 4, True, False
+        )
+        exllamav3_ext.exl3_fat_swiglu_had(
+            gate_up_128, h2_128, down_suh, 10.0
+        )
+        out_128.zero_()
+        exllamav3_ext.exl3_fat_gemm_scatter(
+            h2_128,
+            down,
+            out_128,
+            down_svh,
+            token_idx,
+            route_weight,
+            4,
+            True,
+            False,
+        )
+
+    def launch_64() -> None:
+        exllamav3_ext.exl3_fat_gemm_pair_m64(
+            xh, gate, up, gate_up_64, gate_svh, up_svh, 4, True, False
+        )
+        exllamav3_ext.exl3_fat_swiglu_had(gate_up_64, h2_64, down_suh, 10.0)
+        out_64.zero_()
+        exllamav3_ext.exl3_fat_gemm_scatter_m64(
+            h2_64,
+            down,
+            out_64,
+            down_svh,
+            token_idx,
+            route_weight,
+            4,
+            True,
+            False,
+        )
+
+    launch_128()
+    launch_64()
+    torch.cuda.synchronize()
+    max_abs = float((out_128 - out_64).abs().max())
+    assert torch.equal(gate_up_128, gate_up_64), float(
+        (gate_up_128 - gate_up_64).abs().max()
+    )
+    assert torch.equal(h2_128, h2_64), float((h2_128 - h2_64).abs().max())
+    assert torch.equal(out_128, out_64), max_abs
+
+    launches = {"m128": launch_128, "m64": launch_64}
+    timings: dict[str, list[float]] = {name: [] for name in launches}
+    for repeat in range(args.repeats):
+        order = ("m128", "m64") if repeat % 2 == 0 else ("m64", "m128")
+        for name in order:
+            launch = launches[name]
+            for _ in range(args.warmup):
+                launch()
+            torch.cuda.synchronize()
+            start = torch.cuda.Event(enable_timing=True)
+            end = torch.cuda.Event(enable_timing=True)
+            start.record()
+            for _ in range(args.iterations):
+                launch()
+            end.record()
+            end.synchronize()
+            timings[name].append(start.elapsed_time(end) / args.iterations)
+
+    median_128 = statistics.median(timings["m128"])
+    median_64 = statistics.median(timings["m64"])
+
+    return {
+        "rows": rows,
+        "hidden": hidden,
+        "intermediate": intermediate,
+        "m128_ms": median_128,
+        "m64_ms": median_64,
+        "speedup": median_128 / median_64,
+        "m128_samples_ms": timings["m128"],
+        "m64_samples_ms": timings["m64"],
+        "max_abs": max_abs,
+    }
+
+
+def main() -> None:
+    args = parse_args()
+    required = (
+        "exl3_fat_gemm_m64",
+        "exl3_fat_gemm_pair_m64",
+        "exl3_fat_gemm_scatter_m64",
+    )
+    missing = [name for name in required if not hasattr(exllamav3_ext, name)]
+    if missing:
+        raise RuntimeError(f"extension lacks 64-row variants: {missing}")
+    for rows in args.rows:
+        print(json.dumps(benchmark(args, rows), sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
