@@ -0,0 +1,198 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Test an exact 128-KiB K4 codebook LUT against procedural EXL3 decode.
+
+Both implementations live in the same extension and retain the accepted M64
+geometry, packing, FP32 accumulation, transforms, routing and scatter.  The
+only changed operation is the procedural reconstruction of each 16-bit MCG
+window versus a read-only lookup of the bit-identical FP16 result.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import statistics
+from collections.abc import Callable
+
+import exllamav3_ext
+import torch
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--rows",
+        nargs="+",
+        type=int,
+        default=(129, 192, 320, 512, 768, 1024, 2048, 4096, 6528),
+    )
+    parser.add_argument("--hidden", type=int, default=4096)
+    parser.add_argument("--intermediate", type=int, default=1024)
+    parser.add_argument("--warmup", type=int, default=20)
+    parser.add_argument("--iterations", type=int, default=80)
+    parser.add_argument("--repeats", type=int, default=7)
+    parser.add_argument("--seed", type=int, default=23)
+    return parser.parse_args()
+
+
+def alternating_medians(
+    control: Callable[[], None],
+    candidate: Callable[[], None],
+    warmup: int,
+    iterations: int,
+    repeats: int,
+) -> tuple[float, float, list[float], list[float]]:
+    for _ in range(warmup):
+        control()
+        candidate()
+    torch.cuda.synchronize()
+    control_samples: list[float] = []
+    candidate_samples: list[float] = []
+    for repeat in range(repeats):
+        order = ((control, control_samples), (candidate, candidate_samples))
+        if repeat & 1:
+            order = tuple(reversed(order))
+        for operation, samples in order:
+            start = torch.cuda.Event(enable_timing=True)
+            end = torch.cuda.Event(enable_timing=True)
+            start.record()
+            for _ in range(iterations):
+                operation()
+            end.record()
+            end.synchronize()
+            samples.append(start.elapsed_time(end) / iterations)
+    return (
+        statistics.median(control_samples),
+        statistics.median(candidate_samples),
+        control_samples,
+        candidate_samples,
+    )
+
+
+@torch.inference_mode()
+def benchmark(args: argparse.Namespace, rows: int) -> dict[str, object]:
+    torch.manual_seed(args.seed)
+    device = torch.device("cuda:0")
+    hidden = args.hidden
+    intermediate = args.intermediate
+    gu_shape = (hidden // 16, intermediate // 16, 64)
+    down_shape = (intermediate // 16, hidden // 16, 64)
+
+    xh = torch.randn(rows, hidden, dtype=torch.float16, device=device)
+    gate = torch.randint(-32768, 32767, gu_shape, dtype=torch.int16, device=device)
+    up = torch.randint(-32768, 32767, gu_shape, dtype=torch.int16, device=device)
+    down = torch.randint(-32768, 32767, down_shape, dtype=torch.int16, device=device)
+    gate_svh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    up_svh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    down_suh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    down_svh = torch.randn(hidden, dtype=torch.float16, device=device)
+    token_idx = torch.arange(rows, dtype=torch.int64, device=device)
+    route_weight = torch.rand(rows, dtype=torch.float16, device=device)
+
+    control_gu = torch.empty(rows, 2 * intermediate, dtype=torch.float32, device=device)
+    candidate_gu = torch.empty_like(control_gu)
+    control_h2 = torch.empty(rows, intermediate, dtype=torch.float16, device=device)
+    candidate_h2 = torch.empty_like(control_h2)
+    control_out = torch.empty(rows, hidden, dtype=torch.float32, device=device)
+    candidate_out = torch.empty_like(control_out)
+
+    exllamav3_ext.exl3_fat_init_k4_cb1_lut(xh)
+
+    def control_pair() -> None:
+        exllamav3_ext.exl3_fat_gemm_pair_m64(
+            xh, gate, up, control_gu, gate_svh, up_svh, 4, True, False
+        )
+
+    def candidate_pair() -> None:
+        exllamav3_ext.exl3_fat_gemm_pair_m64_lut(
+            xh, gate, up, candidate_gu, gate_svh, up_svh, 4, True, False
+        )
+
+    def control_scatter() -> None:
+        control_out.zero_()
+        exllamav3_ext.exl3_fat_gemm_scatter_m64(
+            control_h2,
+            down,
+            control_out,
+            down_svh,
+            token_idx,
+            route_weight,
+            4,
+            True,
+            False,
+        )
+
+    def candidate_scatter() -> None:
+        candidate_out.zero_()
+        exllamav3_ext.exl3_fat_gemm_scatter_m64_lut(
+            candidate_h2,
+            down,
+            candidate_out,
+            down_svh,
+            token_idx,
+            route_weight,
+            4,
+            True,
+            False,
+        )
+
+    def control_full() -> None:
+        control_pair()
+        exllamav3_ext.exl3_fat_swiglu_had(control_gu, control_h2, down_suh, 10.0)
+        control_scatter()
+
+    def candidate_full() -> None:
+        candidate_pair()
+        exllamav3_ext.exl3_fat_swiglu_had(
+            candidate_gu, candidate_h2, down_suh, 10.0
+        )
+        candidate_scatter()
+
+    control_full()
+    candidate_full()
+    torch.cuda.synchronize()
+    delta = control_out - candidate_out
+    reference_rms = control_out.square().mean().sqrt()
+
+    timings: dict[str, object] = {}
+    for name, control, candidate in (
+        ("pair", control_pair, candidate_pair),
+        ("scatter", control_scatter, candidate_scatter),
+        ("full", control_full, candidate_full),
+    ):
+        control_ms, candidate_ms, control_samples, candidate_samples = (
+            alternating_medians(
+                control,
+                candidate,
+                args.warmup,
+                args.iterations,
+                args.repeats,
+            )
+        )
+        timings[name] = {
+            "control_ms": control_ms,
+            "candidate_ms": candidate_ms,
+            "speedup": control_ms / candidate_ms,
+            "control_samples_ms": control_samples,
+            "candidate_samples_ms": candidate_samples,
+        }
+
+    return {
+        "rows": rows,
+        "hidden": hidden,
+        "intermediate": intermediate,
+        "relative_rmse": float(delta.square().mean().sqrt() / (reference_rms + 1e-8)),
+        "max_abs": float(delta.abs().max()),
+        "timings": timings,
+    }
+
+
+def main() -> None:
+    args = parse_args()
+    for rows in args.rows:
+        print(json.dumps(benchmark(args, rows), sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
+    main()
