--- /dev/null
+++ b/benchmarks/kernels/benchmark_exl3_fat_pair.py
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Benchmark direct gate/up trellises against per-call packed concatenation.
+
+Run inside a SparkGLM image. The packed case is the accepted E2 implementation:
+two device copies followed by one fat GEMM. The pair case reads both immutable
+expert trellises directly and writes the same concatenated gate/up output.
+"""
+
+import argparse
+import json
+
+import exllamav3_ext
+import torch
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--rows", nargs="+", type=int, default=(129, 512, 2048, 7168))
+    parser.add_argument("--k", type=int, default=4096)
+    parser.add_argument("--n", type=int, default=1024)
+    parser.add_argument("--warmup", type=int, default=20)
+    parser.add_argument("--iterations", type=int, default=100)
+    parser.add_argument("--seed", type=int, default=0)
+    return parser.parse_args()
+
+
+def benchmark(args: argparse.Namespace, rows: int) -> dict[str, float | int]:
+    torch.manual_seed(args.seed)
+    device = torch.device("cuda:0")
+    activations = torch.randn(rows, args.k, dtype=torch.float16, device=device)
+    shape = (args.k // 16, args.n // 16, 64)
+    gate = torch.randint(-32768, 32767, shape, dtype=torch.int16, device=device)
+    up = torch.randint(-32768, 32767, shape, dtype=torch.int16, device=device)
+    gate_svh = torch.randn(args.n, dtype=torch.float16, device=device)
+    up_svh = torch.randn(args.n, dtype=torch.float16, device=device)
+    packed = torch.empty(
+        (shape[0], 2 * shape[1], shape[2]),
+        dtype=torch.int16,
+        device=device,
+    )
+    packed_svh = torch.empty(2 * args.n, dtype=torch.float16, device=device)
+    packed_out = torch.empty(rows, 2 * args.n, dtype=torch.float32, device=device)
+    pair_out = torch.empty_like(packed_out)
+
+    def launch_packed() -> None:
+        packed[:, : shape[1]].copy_(gate)
+        packed[:, shape[1] :].copy_(up)
+        packed_svh[: args.n].copy_(gate_svh)
+        packed_svh[args.n :].copy_(up_svh)
+        exllamav3_ext.exl3_fat_gemm(
+            activations, packed, packed_out, packed_svh, 4, True, False
+        )
+
+    def launch_pair() -> None:
+        exllamav3_ext.exl3_fat_gemm_pair(
+            activations,
+            gate,
+            up,
+            pair_out,
+            gate_svh,
+            up_svh,
+            4,
+            True,
+            False,
+        )
+
+    launch_packed()
+    launch_pair()
+    torch.cuda.synchronize()
+    max_abs = float((packed_out - pair_out).abs().max())
+    assert torch.equal(packed_out, pair_out), max_abs
+
+    timings: dict[str, float] = {}
+    for name, launch in (("packed", launch_packed), ("pair", launch_pair)):
+        for _ in range(args.warmup):
+            launch()
+        torch.cuda.synchronize()
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        for _ in range(args.iterations):
+            launch()
+        end.record()
+        end.synchronize()
+        timings[name] = start.elapsed_time(end) / args.iterations
+
+    return {
+        "rows": rows,
+        "k": args.k,
+        "n_each": args.n,
+        "packed_ms": timings["packed"],
+        "pair_ms": timings["pair"],
+        "speedup": timings["packed"] / timings["pair"],
+        "max_abs": max_abs,
+    }
+
+
+def main() -> None:
+    args = parse_args()
+    for rows in args.rows:
+        print(json.dumps(benchmark(args, rows), sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/benchmarks/kernels/benchmark_exl3_fat_pipeline.py b/benchmarks/kernels/benchmark_exl3_fat_pipeline.py
new file mode 100644
index 0000000000..f3e7f10288
--- /dev/null
+++ b/benchmarks/kernels/benchmark_exl3_fat_pipeline.py
@@ -0,0 +1,152 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Benchmark the accepted and fused GLM-5.3 fat-expert inner pipelines.
+
+The benchmark starts after input gather/Hadamard and includes gate/up weight
+packing, gate/up GEMM, SwiGLU, down-input Hadamard, down GEMM, and scatter.
+"""
+
+import argparse
+import json
+
+import exllamav3_ext
+import torch
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--rows", nargs="+", type=int, default=(129, 512, 2048, 7168))
+    parser.add_argument("--hidden", type=int, default=4096)
+    parser.add_argument("--intermediate", type=int, default=1024)
+    parser.add_argument("--warmup", type=int, default=10)
+    parser.add_argument("--iterations", type=int, default=50)
+    parser.add_argument("--seed", type=int, default=0)
+    return parser.parse_args()
+
+
+def benchmark(args: argparse.Namespace, rows: int) -> dict[str, float | int]:
+    torch.manual_seed(args.seed)
+    device = torch.device("cuda:0")
+    hidden = args.hidden
+    intermediate = args.intermediate
+    xh = torch.randn(rows, hidden, dtype=torch.float16, device=device)
+    gu_shape = (hidden // 16, intermediate // 16, 64)
+    down_shape = (intermediate // 16, hidden // 16, 64)
+    gate = torch.randint(-32768, 32767, gu_shape, dtype=torch.int16, device=device)
+    up = torch.randint(-32768, 32767, gu_shape, dtype=torch.int16, device=device)
+    down = torch.randint(-32768, 32767, down_shape, dtype=torch.int16, device=device)
+    gate_svh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    up_svh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    down_suh = torch.randn(intermediate, dtype=torch.float16, device=device)
+    down_svh = torch.randn(hidden, dtype=torch.float16, device=device)
+    packed = torch.empty(
+        (gu_shape[0], 2 * gu_shape[1], gu_shape[2]),
+        dtype=torch.int16,
+        device=device,
+    )
+    packed_svh = torch.empty(2 * intermediate, dtype=torch.float16, device=device)
+    gate_up = torch.empty(rows, 2 * intermediate, dtype=torch.float32, device=device)
+    act = torch.empty(rows, intermediate, dtype=torch.float32, device=device)
+    act_h = torch.empty(rows, intermediate, dtype=torch.float16, device=device)
+    h2 = torch.empty_like(act_h)
+    token_idx = torch.arange(rows, dtype=torch.int64, device=device)
+    route_weight = torch.rand(rows, dtype=torch.float16, device=device)
+    accepted_out = torch.empty(rows, hidden, dtype=torch.float32, device=device)
+    fused_out = torch.empty_like(accepted_out)
+
+    def launch_accepted() -> None:
+        packed[:, : gu_shape[1]].copy_(gate)
+        packed[:, gu_shape[1] :].copy_(up)
+        packed_svh[:intermediate].copy_(gate_svh)
+        packed_svh[intermediate:].copy_(up_svh)
+        exllamav3_ext.exl3_fat_gemm(xh, packed, gate_up, packed_svh, 4, True, False)
+        gate_out = gate_up[:, :intermediate]
+        up_out = gate_up[:, intermediate:]
+        gate_out.clamp_(max=10.0)
+        up_out.clamp_(min=-10.0, max=10.0)
+        torch.sigmoid(gate_out, out=act)
+        act.mul_(gate_out).mul_(up_out)
+        act_h.copy_(act)
+        exllamav3_ext.had_r_128(act_h, h2, down_suh, None, 1.0)
+        accepted_out.zero_()
+        exllamav3_ext.exl3_fat_gemm_scatter(
+            h2,
+            down,
+            accepted_out,
+            down_svh,
+            token_idx,
+            route_weight,
+            4,
+            True,
+            False,
+        )
+
+    def launch_fused() -> None:
+        exllamav3_ext.exl3_fat_gemm_pair(
+            xh,
+            gate,
+            up,
+            gate_up,
+            gate_svh,
+            up_svh,
+            4,
+            True,
+            False,
+        )
+        exllamav3_ext.exl3_fat_swiglu_had(gate_up, h2, down_suh, 10.0)
+        fused_out.zero_()
+        exllamav3_ext.exl3_fat_gemm_scatter(
+            h2,
+            down,
+            fused_out,
+            down_svh,
+            token_idx,
+            route_weight,
+            4,
+            True,
+            False,
+        )
+
+    launch_accepted()
+    launch_fused()
+    torch.cuda.synchronize()
+    max_abs = float((accepted_out - fused_out).abs().max())
+    assert torch.isfinite(fused_out).all()
+    assert torch.equal(accepted_out, fused_out), (
+        max_abs,
+        int((accepted_out != fused_out).sum()),
+    )
+
+    timings: dict[str, float] = {}
+    for name, launch in (("accepted", launch_accepted), ("fused", launch_fused)):
+        for _ in range(args.warmup):
+            launch()
+        torch.cuda.synchronize()
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        for _ in range(args.iterations):
+            launch()
+        end.record()
+        end.synchronize()
+        timings[name] = start.elapsed_time(end) / args.iterations
+
+    return {
+        "rows": rows,
+        "hidden": hidden,
+        "intermediate": intermediate,
+        "accepted_ms": timings["accepted"],
+        "fused_ms": timings["fused"],
+        "speedup": timings["accepted"] / timings["fused"],
+        "max_abs": max_abs,
+    }
+
+
+def main() -> None:
+    args = parse_args()
+    for rows in args.rows:
+        print(json.dumps(benchmark(args, rows), sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
